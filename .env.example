# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
# 세 값 모두 브라우저에 노출되는 공개 값이다. 비밀 키는 이 앱에서 쓰지 않는다.

# Supabase 프로젝트 주소와 공개(publishable) 키: 대시보드 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 카카오맵 JavaScript 키: developers.kakao.com > 내 애플리케이션 > 앱 키
# 비워 두면 지도와 장소 검색 없이 목록만 쓴다.
NEXT_PUBLIC_KAKAO_JS_KEY=
